{
  "name": "@seed-design/rootage-artifacts",
  "version": "0.0.0-alpha-20260416134952",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daangn/seed-design.git",
    "directory": "packages/rootage"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "rootage:generate": "bun rootage json-schema ./components && bun rootage json ./dist"
  },
  "main": "package.json",
  "files": [
    "*.yaml",
    "components/*.yaml",
    "dist/**/*.json"
  ],
  "exports": {
    ".": "./package.json",
    "./package.json": "./package.json",
    "./index.json": "./dist/index.json",
    "./components/*.json": "./dist/components/*.json",
    "./*.json": "./dist/*.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
