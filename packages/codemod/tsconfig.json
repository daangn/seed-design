{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Bundler",
    "types": ["node", "bun"],
    "esModuleInterop": true,
    "preserveWatchOutput": true,
    "isolatedModules": false,
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.js", "src/**/*.jsx"],
  "exclude": ["node_modules", "__testfixtures__"]
}
