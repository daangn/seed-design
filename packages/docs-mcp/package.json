{
  "name": "@seed-design/docs-mcp",
  "version": "1.0.0",
  "description": "The official MCP server for SEED Design documentation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daangn/seed-design.git",
    "directory": "packages/docs-mcp"
  },
  "author": "@junghyeonsu",
  "homepage": "https://seed-design.io/",
  "license": "MIT",
  "type": "module",
  "main": "dist/stdio.js",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "bin": {
    "seed-docs-mcp": "./dist/stdio.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsup && chmod 755 dist/stdio.js",
    "dev": "tsup --watch",
    "serve": "tsx --watch src/stdio.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.0",
    "lru-cache": "^11.0.2",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "seed-design",
    "mcp-server",
    "mcp",
    "ai",
    "documentation"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
