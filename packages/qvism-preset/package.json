{
  "name": "@seed-design/qvism-preset",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daangn/seed-design.git",
    "directory": "packages/qvism-preset"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "main": "./lib/index.cjs",
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "clean": "rm -rf lib",
    "rootage:generate": "bun rootage token-css ./src && bun run ./write-tokens.mjs && bun rootage token-ts ./src/vars && rootage component-spec ./src/vars/component",
    "build": "bunchee",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@seed-design/qvism-core": "0.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
