{
  "name": "@seed-design/webpack-plugin",
  "version": "0.0.1-rc.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daangn/seed-design.git",
    "directory": "packages/webpack-plugin"
  },
  "author": "Asher <asher@daangn.com>",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "main": "./lib/index.cjs",
  "sideEffects": false,
  "files": [
    "lib",
    "src",
    "seed-recipe-loader.js"
  ],
  "scripts": {
    "clean": "rm -rf lib",
    "build": "bun build.mjs && tsc --emitDeclarationOnly",
    "lint:publish": "bun publint"
  },
  "dependencies": {},
  "devDependencies": {
    "@rspack/core": "^1.2.5",
    "@seed-design/css": "^0.0.1-rc.4",
    "html-webpack-plugin": "^5.6.3",
    "webpack": "^5.20.2"
  },
  "peerDependencies": {
    "html-webpack-plugin": "^5.6.3",
    "webpack": "^5.20.2",
    "@rspack/core": "^1.2.5",
    "@seed-design/css": "^0.0.1-rc.4"
  },
  "peerDependenciesMeta": {
    "webpack": {
      "optional": true
    },
    "html-webpack-plugin": {
      "optional": true
    },
    "@rspack/core": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
