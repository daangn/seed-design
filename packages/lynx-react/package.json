{
  "name": "@seed-design/lynx-react",
  "version": "1.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daangn/seed-design.git",
    "directory": "packages/lynx-react"
  },
  "license": "Apache-2.0",
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./content-placeholder-presets/*": {
      "types": "./lib/content-placeholder-presets/*.d.ts",
      "import": "./lib/content-placeholder-presets/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "clean": "rm -rf lib",
    "build": "vite build",
    "lint:publish": "bun publint",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:published": "bun run build && vitest run --config vitest.published.config.ts"
  },
  "peerDependencies": {
    "@lynx-js/react": ">=0.117.0",
    "@lynx-js/types": ">=3.9.0",
