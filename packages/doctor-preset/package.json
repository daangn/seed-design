{
  "name": "@seed-design/doctor-preset",
  "version": "0.0.0",
  "description": "SEED Design rule pack for SEED Doctor — rules plus knowledge loaders backed by seed-design.io artifacts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daangn/seed-design.git",
    "directory": "packages/doctor-preset"
  },
  "homepage": "https://seed-design.io/",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bunchee",
    "lint": "biome check ./src",
    "lint:fix": "biome check --fix ./src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@seed-design/doctor-core": "^0.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "bunchee": "^6.3.2",
    "typescript": "^6.0.0"
  },
  "keywords": [
    "seed-design",
    "doctor",
    "lint",
    "rules"
  ],
  "publishConfig": {
    "access": "public"
  }
}
