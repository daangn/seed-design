{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "~/registry/ui/*": ["../../docs/registry/ui/*"]
    }
  },
  "include": ["src", "../../packages/json-render/src"]
}
