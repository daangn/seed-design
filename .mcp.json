{
  "mcpServers": {
    "seed-design": {
      "type": "stdio",
      "command": "bunx",
      "args": ["-y", "@seed-design/mcp@latest"]
    },
    "seed-design-local": {
      "type": "stdio",
      "command": "bun",
      "args": ["./packages/mcp/bin/index.mjs"]
    },
    "playwright": {
      "command": "bunx",
      "args": ["@playwright/mcp@latest"]
    }
  }
}
