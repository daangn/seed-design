{
  "name": "@seed-design/figma-codegen",
  "private": true,
  "version": "0.0.0",
  "author": "Asher <asher@daangn.com>",
  "dependencies": {
    "@seed-design/figma": "0.0.27"
  },
  "devDependencies": {
    "@create-figma-plugin/build": "^4.0.1",
    "@create-figma-plugin/tsconfig": "^4.0.0",
    "@figma/plugin-typings": "^1.110.0",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build": "build-figma-plugin --typecheck --minify",
    "dev": "build-figma-plugin --typecheck --watch"
  },
  "figma-plugin": {
    "editorType": [
      "dev"
    ],
    "capabilities": [
      "codegen"
    ],
    "codegenLanguages": [
      {
        "label": "React",
        "value": "react"
      }
    ],
    "id": "1469592983561656263",
    "name": "Seed Design Codegen",
    "main": "src/main.ts",
    "documentAccess": "dynamic-page",
    "networkAccess": {
      "allowedDomains": [
        "none"
      ]
    }
  }
}
