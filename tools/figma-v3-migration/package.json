{
  "name": "figma-v3-migration",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun run build:ui && bun run build:main",
    "build:ui": "vite build --config vite.ui.config.ts",
    "build:main": "vite build --config vite.main.config.ts",
    "watch": "concurrently \"bun run watch:ui\" \"bun run watch:main\"",
    "watch:ui": "vite build --watch --config vite.ui.config.ts",
    "watch:main": "vite build --watch --config vite.main.config.ts",
    "dev": "concurrently \"bun run watch:ui\" \"bun run watch:main\"",
    "lint": "biome check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@figmazing/event": "0.0.1",
    "@karrotmarket/react-monochrome-icon": "^0.0.23",
    "@seed-design/css": "^0.0.25",
    "@seed-design/migration-index": "^0.0.20",
    "@seed-design/react": "^0.0.25",
    "@seed-design/vite-plugin": "^0.0.26",
    "normalize.css": "^8.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.110.0",
    "@types/node": "^22.14.1",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.3.3",
    "vite-plugin-singlefile": "^2.2.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
