{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":preserveSemverRanges",
    "helpers:pinGitHubActionDigests",
    "security:minimumReleaseAgeNpm"
  ],
  "baseBranchPatterns": ["dev"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Match bunfig.toml minimumReleaseAgeExcludes",
      "matchPackageNames": [
        "@seed-design/rootage-artifacts",
        "@kaptures/cli",
        "@kaptures/storybook"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchPackageNames": ["tailwindcss"],
      "matchFileNames": ["packages/tailwind3-plugin/**"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@manypkg/get-packages"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@seed-design/react-icon"],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "@karrotmarket/icon-data",
        "@karrotmarket/lynx-monochrome-icon",
        "@karrotmarket/lynx-multicolor-icon",
        "@karrotmarket/react-monochrome-icon",
        "@karrotmarket/react-multicolor-icon"
      ],
      "groupName": "karrot-icon-updates",
      "groupSlug": "karrot-icon-updates",
      "minimumReleaseAge": "0 days",
      "allowedVersions": "*"
    },
    {
      "matchPackageNames": ["bun"],
      "groupName": "bun"
    },
    {
      "description": "lynx-stack packages must be updated together",
      "matchSourceUrls": ["https://github.com/lynx-family/lynx-stack"],
      "groupName": "lynx-stack",
      "groupSlug": "lynx-stack"
    },
    {
      "description": "Lynx commit 테스트 기댓값은 Preact 10 계열(@lynx-js/react 0.125 이하)에서 고정한다. 0.126부터 Preact 11이라 개발 버전을 0.125.x에 둔다.",
      "matchPackageNames": ["@lynx-js/react"],
      "allowedVersions": "<0.126.0"
    },
    {
      "description": "@lynx-js/react 0.125를 peer로 허용하는 마지막 React 플러그인은 0.20.x다. 0.21부터 peer가 ^0.128이다.",
      "matchPackageNames": ["@lynx-js/react-rsbuild-plugin"],
      "allowedVersions": "<0.21.0"
    },
    {
      "description": "React 플러그인 0.20.4와 같은 @lynx-js/rsbuild-plugin 0.1.4·template-webpack-plugin 0.16.3을 쓰는 마지막 Rspeedy는 0.18.1이다. 0.18.2부터 이 내부 plugin이 두 벌로 설치된다.",
      "matchPackageNames": ["@lynx-js/rspeedy"],
      "allowedVersions": "<0.18.2"
    }
  ]
}
