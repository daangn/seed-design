{
  "name": "@seed-design/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "bun run prepare:figma-images && bun run typecheck && bun run build:lynx-examples && bun run build:turbopack && bun run generate:changelog-llms",
    "build:turbopack": "bun run prepare:git-timestamps && SEED_USE_GIT_TIMESTAMPS_MANIFEST=1 NEXT_EXTERNAL_TYPECHECK=1 next build --turbopack && bun run generate:llms-full",
    "dev": "bun run prepare:lynx-workspace && local-md dev -- concurrently \"bun --filter @seed-design/lynx-react build --watch\" \"bun run dev:lynx-examples\" \"bun --filter @seed-design/stackflow-spa dev\" \"next dev --webpack\"",
    "start": "concurrently \"bun --filter @seed-design/stackflow-spa dev\" \"next start\"",
    "sanity:dev": "sanity dev",
    "sanity:start": "sanity start",
    "sanity:build": "sanity build",
    "prepare:figma-images": "bun scripts/prepare-figma-images.ts",
    "prepare:git-timestamps": "bun scripts/prepare-git-timestamps.ts",
    "gen": "bun generate:all",
    "generate:all": "bun generate:registry && bun generate:docs-index && bun generate:component-grid-manifest",
    "generate:registry": "bun scripts/generate-registry.ts",
    "generate:docs-index": "bun scripts/generate-docs-index.ts",
    "generate:component-grid-manifest": "bun scripts/generate-component-grid-manifest.ts",
    "generate:changelog-llms": "bun scripts/generate-changelog-llms.ts",
    "generate:llms-full": "bun scripts/generate-llms-full.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "bun run prepare:lynx-workspace && bun run typecheck:web && bun run typecheck:lynx-examples && bun run typecheck:lynx-tooling",
    "images:og:generate": "bun scripts/generate-og-cover-assets.ts",
    "images:og:validate": "bun scripts/validate-og-cover-assets.ts",
    "prepare:lynx-workspace": "bun scripts/lynx-examples/prepare-workspace.ts",
    "typecheck:web": "next typegen && node node_modules/@typescript/native/bin/tsc --noEmit",
    "typecheck:lynx-examples": "bun node_modules/typescript/bin/tsc -p examples/lynx/tsconfig.json",
    "typecheck:lynx-tooling": "bun node_modules/typescript/bin/tsc -p tsconfig.lynx-node.json",
    "build:lynx-examples": "bun scripts/lynx-examples/build.ts",
    "build:lynx-examples:development": "bun scripts/lynx-examples/build.ts --development",
    "dev:lynx-examples": "bun scripts/lynx-examples/watch.ts"
  },
