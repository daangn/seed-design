---
/**
 * Updates 목록(`/updates`). 사이드바 없는 문서 셸에 기존 `app/updates/page.tsx`(ProsePage)와 같은 마크업을 그린다.
 * 릴리즈 노트(`category: release`)는 썸네일 없는 카드로 위에, 블로그 글은 카드 그리드로 아래에 둔다.
 *
 * 카드 = 내부 Updates 글 + 외부 팀블로그 글(`BLOG_POSTS`의 `external: true`, landing과 공유). publishedAt 내림차순이고
 * 날짜가 없으면 맨 위다. 썸네일은 frontmatter `coverImage`, 없으면 Figma 커버 manifest(`prepare:figma-images`), 없으면
 * Updates 섹션 커버다. render 중 Figma를 조회하지 않는다(기존 Next는 빌드 때 Figma API를 불렀다).
 */
import { IconSeedArrow } from "../../../components/icon-seed-arrow";
import { BLOG_POSTS } from "../../../components/landing/lib/landing-content";
import { SiteFooter } from "../../../components/layout/site-footer";
import { ReleaseCard } from "../../../components/updates/release-card";
import { formatPublishedDate } from "../../../lib/format-date";
import { getLLMMarkdownUrl } from "../../../lib/llms/config";
import { resolveCoverImage } from "../../../lib/seo";
import { publicFileExists } from "../../content/public-files";
import { getSectionConfig, isSectionInBuild } from "../../content/sections";
import { listPages, pageHead } from "../../content/source";
import DocsShell from "../../layouts/DocsShell.astro";

const TITLE = "Updates";
const DESCRIPTION = "SEED 업데이트 소식과 릴리즈 노트";
const INTERNAL_FALLBACK = "/og/updates.webp";
const SECTION_HEADING_CLASS =
  "mb-5 text-xl font-semibold tracking-tight text-fd-foreground md:mb-6 md:text-2xl";

interface UpdateCard {
  title: string;
  description?: string;
  image: string;
  href: string;
  /** ISO 문자열. 없으면 정렬에서 맨 위. */
  publishedAt?: string;
  external: boolean;
  category: "post" | "release";
}

const figmaManifest = Object.values(
  import.meta.glob<{ images?: Record<string, string> }>("/.cache/figma-image/build-manifest.json", {
    eager: true,
    import: "default",
  }),
)[0];

// archive 빌드에는 updates 섹션이 없다(보관본 exporter도 이 쪽을 복사하지 않는다). 외부 글만 남는다.
const pages = isSectionInBuild("updates") ? await listPages("updates") : [];
const internal: UpdateCard[] = pages.map((page) => ({
    title: page.title,
    description: page.description,
    image:
      (page.coverImage && resolveCoverImage(page.coverImage, publicFileExists).thumbnail) ||
      (page.coverImageFigmaId && figmaManifest?.images?.[page.coverImageFigmaId]) ||
      INTERNAL_FALLBACK,
    href: page.url,
    publishedAt: page.publishedAt ? new Date(page.publishedAt).toISOString() : undefined,
    external: false,
    category: page.category ?? "post",
  }));
const external: UpdateCard[] = BLOG_POSTS.filter((post) => post.external).map((post) => ({
  title: post.title,
  description: post.description,
  image: post.image,
  href: post.href,
  publishedAt: post.publishedAt,
  external: true,
  category: "post",
}));
const time = (card: UpdateCard) =>
  card.publishedAt ? new Date(card.publishedAt).getTime() : Number.POSITIVE_INFINITY;
const cards = [...external, ...internal].sort((a, b) => time(b) - time(a));
const releases = cards.filter((card) => card.category === "release");
const posts = cards.filter((card) => card.category !== "release");

const cover = resolveCoverImage("/og/updates", publicFileExists);
const head = pageHead({
  title: TITLE,
  description: DESCRIPTION,
  image: cover.og,
  llmsTxtUrl: getLLMMarkdownUrl("updates", []),
});
---

<DocsShell head={head} section={getSectionConfig("updates")} currentPath="/updates" nav={null} tocRail={false}>
  <div id="nd-page" class="[grid-area:main] w-full px-4 py-10 md:px-6 md:py-16 xl:px-8">
    <div class="mx-auto w-full max-w-[1100px]">
      <div class="">
        <header class="not-prose mb-10 md:mb-14">
          <h1 class="text-fd-foreground text-3xl font-medium tracking-tight text-balance md:text-[40px] text-balance break-keep">{TITLE}</h1>
          <p class="text-fd-muted-foreground mt-4 text-base font-light text-pretty">{DESCRIPTION}</p>
        </header>
        <div class="prose flex-1 max-w-none prose-p:break-keep prose-p:text-pretty prose-headings:text-balance">
          <div class="not-prose mb-8 md:mb-10">
            <img src={cover.thumbnail} alt="업데이트 표지" width={cover.og.width} height={cover.og.height} class="block h-auto w-full rounded-r4" loading="eager" />
          </div>
          {
            releases.length > 0 && (
              <section class="not-prose mb-12 md:mb-16">
                <h2 class={SECTION_HEADING_CLASS}>Release Notes</h2>
                <div class="grid grid-cols-1 gap-y-x4 sm:grid-cols-2 sm:gap-x-x6">
                  {releases.map((card) => (
                    <ReleaseCard href={card.href} title={card.title} description={card.description} publishedAt={card.publishedAt} />
                  ))}
                </div>
              </section>
            )
          }
          <section class="not-prose">
            <h2 class={SECTION_HEADING_CLASS}>Blog</h2>
            <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-2">
              {
                posts.map((card) => {
                  const published = card.publishedAt ? new Date(card.publishedAt) : null;
                  return (
                    <a
                      href={card.href}
                      target={card.external ? "_blank" : undefined}
                      rel={card.external ? "noreferrer" : undefined}
                      class="group block"
                    >
                      <div class="mb-4 overflow-hidden rounded-r4">
                        <img
                          src={card.image}
                          alt=""
                          class="aspect-video w-full object-cover transition-transform duration-500 ease-out group-hover:[transform:scale(1.03)]"
                          loading="lazy"
                        />
                      </div>
                      {published && (
                        <time datetime={published.toISOString()} class="text-sm text-fd-muted-foreground">
                          {formatPublishedDate(published)}
                        </time>
                      )}
                      <div class="mt-1 flex items-start justify-between gap-2">
                        <h3 class="text-balance break-keep wrap-anywhere text-lg font-medium">{card.title}</h3>
                        {/* 새 탭으로 나가는 외부 글에만 ↗를 단다. */}
                        {card.external && (
                          <IconSeedArrow external className="mt-1 size-4 -translate-y-[0.5px] text-fd-muted-foreground" />
                        )}
                      </div>
                      {card.description && <p class="mt-1 text-sm text-fd-muted-foreground">{card.description}</p>}
                    </a>
                  );
                })
              }
            </div>
          </section>
        </div>
      </div>
      <SiteFooter />
    </div>
  </div>
</DocsShell>
