---
import {
  UPDATES_COVER_IMAGE,
  UPDATES_DESCRIPTION,
  UPDATES_TITLE,
  UpdatesIndex,
} from "@/components/updates/updates-index";
import { getLLMMarkdownUrl } from "@/lib/llms/config";
import { TAGS } from "@/lib/search-tags";
import { buildSeoMetadata, resolveCoverImage } from "@/lib/seo";
import { getUpdatesSource } from "@/lib/source";
import DocsPage from "@/src/components/DocsPage.astro";

const source = await getUpdatesSource();
const cover = resolveCoverImage(UPDATES_COVER_IMAGE);
---

<DocsPage
  metadata={buildSeoMetadata({
    title: UPDATES_TITLE,
    description: UPDATES_DESCRIPTION,
    image: cover.og,
  })}
  section="updates"
  markdownUrl={getLLMMarkdownUrl("updates", [])}
  pathname="/updates"
  tree={source.pageTree}
  sidebar={false}
  defaultSearchTag={TAGS.updates.value}
  prose={{
    title: UPDATES_TITLE,
    titleClassName: "text-balance break-keep",
    description: UPDATES_DESCRIPTION,
    coverImage: {
      src: cover.thumbnail,
      alt: "업데이트 표지",
      width: cover.og.width,
      height: cover.og.height,
    },
  }}
>
  <UpdatesIndex />
</DocsPage>
