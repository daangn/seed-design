---
import type { InferGetStaticPropsType } from "astro";
import { coverImageProps, docsStaticPaths, loadDocsPage } from "@/lib/docs-page";
import { getLLMMarkdownUrl } from "@/lib/llms/config";
import { TAGS } from "@/lib/search-tags";
import { buildDocsPageJsonLd, buildDocsPageMetadata } from "@/lib/seo";
import { getAiIntegrationSource } from "@/lib/source";
import DocsPage from "@/src/components/DocsPage.astro";

export const getStaticPaths = () => docsStaticPaths(getAiIntegrationSource);

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props;
const source = await getAiIntegrationSource();
const { Content, toc, lastModified } = await loadDocsPage(page);
const markdownUrl = getLLMMarkdownUrl("ai-integration", page.slugs);
const displayTitle = page.data.heading ?? page.data.title;
---

<DocsPage
  metadata={buildDocsPageMetadata({
    url: page.url,
    title: page.data.title,
    heading: page.data.heading,
    description: page.data.description,
    coverImage: page.data.coverImage,
  })}
  section="ai-integration"
  markdownUrl={markdownUrl}
  jsonLd={buildDocsPageJsonLd(page)}
  Content={Content}
  pathname={page.url}
  tree={source.pageTree}
  defaultSearchTag={TAGS.aiIntegration.value}
  page={{
    title: displayTitle,
    description: page.data.description,
    coverImage: coverImageProps(page.data.coverImage, `${displayTitle} cover image`),
    layout: page.data.layout,
    full: page.data.full,
    toc,
    lastUpdate: lastModified,
    showPageActions: page.slugs.length > 0,
    markdownUrl,
  }}
/>
