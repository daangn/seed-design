---
import type { InferGetStaticPropsType } from "astro";
import { docsStaticPaths, loadDocsPage } from "@/lib/docs-page";
import { getLLMMarkdownUrl } from "@/lib/llms/config";
import { getComponentStatus } from "@/lib/rootage";
import { buildDocsPageJsonLd, buildDocsPageMetadata, deprecatedTitle } from "@/lib/seo";
import { getDocsSource } from "@/lib/source";
import DocsPage from "@/src/components/DocsPage.astro";

export const getStaticPaths = () => docsStaticPaths(getDocsSource);

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props;
const source = await getDocsSource();
const [{ Content, toc, lastModified }, { deprecated }] = await Promise.all([
  loadDocsPage(page),
  getComponentStatus({ slug: page.slugs }, { deprecated: page.data.deprecated }),
]);
const markdownUrl = getLLMMarkdownUrl("docs", page.slugs);
---

<DocsPage
  metadata={buildDocsPageMetadata({
    url: page.url,
    title: page.data.title,
    description: page.data.description,
    deprecated,
  })}
  section="docs"
  markdownUrl={markdownUrl}
  jsonLd={buildDocsPageJsonLd(page)}
  Content={Content}
  pathname={page.url}
  tree={source.pageTree}
  page={{
    title: deprecatedTitle(page.data.title, deprecated),
    description: page.data.description,
    layout: page.data.layout,
    full: page.data.full,
    toc,
    lastUpdate: lastModified,
    showPageActions: page.slugs.length > 0,
    markdownUrl,
  }}
/>
