---
import "@seed-design/css/base.layered.css";
import "simple-reveal/index.css";
import "@/src/styles/global.css";

import { LatestVersionBanner } from "@/components/latest-version-banner";
import { RecentPagesRecorder } from "@/components/recent-pages-recorder";
import { SiteAnnouncementBanner } from "@/components/site-announcement-banner";
import ThemeSync from "@/components/theme-sync";
import { archivePaths } from "@/lib/docs-archive";
import type { SeoMetadata } from "@/lib/seo";
import Analytics from "@/src/components/Analytics.astro";
import SeoHead from "@/src/components/SeoHead.astro";
import layerOrder from "@/src/styles/layer-order.css?raw";

interface Props {
  metadata: SeoMetadata;
  viewport?: string;
}

const { metadata, viewport = "width=device-width, initial-scale=1" } = Astro.props;
---

<!doctype html>
<html lang="ko" data-seed="true" data-seed-user-color-scheme="light" data-seed-color-mode="system">
  <head>
    <meta charset="utf-8" />
    {/* cascade layer 순서를 모든 stylesheet보다 먼저 선언한다. CSS 파일로 두면 dev 서버가 recipe CSS를
        먼저 주입해 `seed-components`가 Tailwind `base`보다 낮아지고, preflight가 recipe의 padding을 지운다. */}
    <style is:inline set:html={layerOrder} />
    <meta name="viewport" content={viewport} />
    <SeoHead metadata={metadata} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={archivePaths.asset("/favicon.ico")} sizes="32x32" />
    <link rel="icon" href={archivePaths.asset("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={archivePaths.asset("/apple-touch-icon.png")} />
    <link rel="manifest" href={archivePaths.asset("/site.webmanifest")} />
    {/* Pretendard (dynamic-subset variable weight 100–900). Rebrand PoC font,
        served from jsDelivr for now — self-host before daangn/prod. Applied as the
        base font-family in src/styles/global.css. */}
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.css"
    />
    <slot name="head" />
    <Analytics />
  </head>
  <body>
    {/* 아래 넷은 서버에서 아무것도 그리지 않고 브라우저 상태(주소·localStorage·테마)로만 동작한다.
        `client:load`로 두면 Astro가 렌더러를 고르려고 컴포넌트를 직접 호출해 dev에서 React hook 경고가 난다. */}
    <LatestVersionBanner client:only="react" />
    <ThemeSync client:only="react" />
    <RecentPagesRecorder client:only="react" />
    <slot />
    <SiteAnnouncementBanner client:only="react" />
  </body>
</html>
