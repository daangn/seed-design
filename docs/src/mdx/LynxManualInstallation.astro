---
import { registryItem } from "../../lib/registry-item";
import InstallationSteps from "./InstallationSteps.astro";

interface Props {
  name: string;
  /** `rehypeWidgetMarkers`가 붙이는 아코디언 root id. */
  accordionId?: string;
}

const { name, accordionId } = Astro.props;
const item = registryItem(`lynx/ui/${name}`);
---

{
  item ? (
    <InstallationSteps
      accordionId={accordionId}
      item={item}
      steps={[{ title: "아래 코드를 복사 후 붙여넣고 사용하세요", snippets: item.snippets.map(({ content }) => ({ content, lang: "tsx" })) }]}
    />
  ) : (
    <div>Lynx 레지스트리를 불러올 수 없습니다. `bun generate:all`을 실행해주세요.</div>
  )
}
