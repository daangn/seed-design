---
/** fumadocs `File`과 같은 마크업(정적). */
import { ICONS } from "./icons";

interface Props {
  name: string;
}

const { name } = Astro.props;
---

<div class="flex flex-row items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-fd-accent hover:text-fd-accent-foreground [&_svg]:size-4">
  <Fragment set:html={ICONS.file} />{name}
</div>
