---
/**
 * `<CatalogGrid pathPrefix="/components/" />`: 섹션 개요의 카드 그리드. 마크업은 기존 `components/catalog/{grid,card}.tsx`와
 * 같다. 항목은 `source.ts#listCatalogItems`가 page tree에서 고른다. 커버는 frontmatter `coverImage`, 없으면 Figma 이미지
 * manifest(`prepare:figma-images`가 만든다)의 URL이다. render 중 Figma를 조회하지 않는다.
 * 항목을 await하므로 아래에 React 컴포넌트를 두지 않는다.
 */
import { resolveCoverImage } from "../../lib/seo";
import { publicFileExists } from "../content/public-files";
import { listCatalogItems } from "../content/source";

interface Props {
  pathPrefix: string;
}

const { pathPrefix } = Astro.props;
const items = await listCatalogItems(pathPrefix);
const figmaManifest = Object.values(
  import.meta.glob<{ images?: Record<string, string> }>("/.cache/figma-image/build-manifest.json", {
    eager: true,
    import: "default",
  }),
)[0];
const isFoundations = pathPrefix.startsWith("/foundations/");
const placeholder =
  '<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="seed-content-placeholder__asset seed-content-placeholder__asset--type_image"><path fill-rule="evenodd" clip-rule="evenodd" d="M51.2 5.33325H12.8C8.66665 5.33325 5.33331 8.66659 5.33331 12.7999V51.1999C5.33331 55.3333 8.66665 58.6666 12.8 58.6666H51.2C55.3333 58.6666 58.6666 55.3333 58.6666 51.1999V12.7999C58.6666 8.66659 55.3333 5.33325 51.2 5.33325ZM42.6666 16.2666C44.88 16.2666 46.6666 18.0533 46.6666 20.2666C46.6666 22.4799 44.88 24.2666 42.6666 24.2666C40.4533 24.2666 38.6666 22.4799 38.6666 20.2666C38.6666 18.0533 40.4533 16.2666 42.6666 16.2666ZM49.8666 45.4399C48.8266 46.4799 47.12 46.4533 46.1066 45.4133L42.4533 41.6799L38.72 45.4399C38.2133 45.9466 37.5466 46.2133 36.8266 46.2133C36.1066 46.2133 35.44 45.9199 34.9333 45.4133L26.48 36.7199L17.9466 45.4399C16.9066 46.4799 15.2266 46.5066 14.1866 45.4666C13.1466 44.4266 13.12 42.7466 14.16 41.6799L24.6133 31.0133C25.12 30.5066 25.8133 30.2133 26.5066 30.2133C27.2266 30.2133 27.92 30.5066 28.4266 31.0133L36.88 39.7333L40.6133 35.9733C41.12 35.4666 41.7866 35.1999 42.5066 35.1999C43.2266 35.1999 43.8933 35.4933 44.4 35.9999L49.9466 41.6533C50.9866 42.6933 50.96 44.3999 49.92 45.4399H49.8666Z"></path></svg>';
const cover = (item: (typeof items)[number]) =>
  item.coverImage
    ? resolveCoverImage(item.coverImage, publicFileExists).thumbnail
    : item.coverImageFigmaId
      ? figmaManifest?.images?.[item.coverImageFigmaId]
      : undefined;
---

{/* SEED breakpoint lg(1280px) 이상에서 3열, 그 미만은 2열 */}
<ul class="grid grid-cols-2 gap-x-x5 gap-y-x6 not-prose pb-10 min-[768px]:gap-x-x6 min-[768px]:gap-y-x8 min-[1280px]:grid-cols-3">
  {
    items.map((item) => {
      const src = cover(item);
      return (
        <li>
          <a class="group flex flex-col gap-x3 min-[768px]:gap-x5" href={item.url}>
            <div
              class="relative aspect-video overflow-hidden"
              style={`border-radius:${isFoundations ? "var(--seed-radius-r3)" : "var(--seed-radius-r2)"}`}
            >
              <div class="seed-content-placeholder__root seed-content-placeholder__root--type_image absolute inset-0 size-full" set:html={placeholder} />
              {src && (
                <img
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 block size-full object-cover transition-transform duration-[600ms] ease-out group-hover:[transform:scale(1.05)]"
                  style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent"
                  src={src}
                />
              )}
            </div>
            <h2 class="t9-medium text-fg-neutral max-md:text-[16px]/[24px] md:text-[20px]/[30px]">{item.title}</h2>
          </a>
        </li>
      );
    })
  }
</ul>
