---
import type { SeoMetadata } from "@/lib/seo";

interface Props {
  metadata: SeoMetadata;
}

const { metadataBase, title, description, alternates, openGraph, twitter } = Astro.props.metadata;
const absolute = (url: string) => new URL(url, metadataBase).toString();
---

{title !== undefined && <title>{title}</title>}
{description && <meta name="description" content={description} />}
{alternates && <link rel="canonical" href={absolute(alternates.canonical)} />}
{openGraph.title !== undefined && <meta property="og:title" content={openGraph.title} />}
{
  openGraph.description && (
    <meta property="og:description" content={openGraph.description} />
  )
}
{openGraph.url !== undefined && <meta property="og:url" content={absolute(openGraph.url)} />}
<meta property="og:site_name" content={openGraph.siteName} />
<meta property="og:locale" content={openGraph.locale} />
{
  openGraph.images.map((image) => (
    <>
      <meta property="og:image" content={absolute(image.url)} />
      {image.type !== undefined && <meta property="og:image:type" content={image.type} />}
      {image.width !== undefined && <meta property="og:image:width" content={String(image.width)} />}
      {
        image.height !== undefined && (
          <meta property="og:image:height" content={String(image.height)} />
        )
      }
      {image.alt !== undefined && <meta property="og:image:alt" content={image.alt} />}
    </>
  ))
}
<meta property="og:type" content={openGraph.type} />
{
  openGraph.publishedTime !== undefined && (
    <meta property="article:published_time" content={openGraph.publishedTime} />
  )
}
<meta name="twitter:card" content={twitter.card} />
{twitter.title !== undefined && <meta name="twitter:title" content={twitter.title} />}
{
  twitter.description && (
    <meta name="twitter:description" content={twitter.description} />
  )
}
{twitter.images.map((image) => <meta name="twitter:image" content={absolute(image)} />)}
