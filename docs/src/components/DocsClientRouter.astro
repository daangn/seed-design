---
import { ClientRouter } from "astro:transitions";
---

{/* 페이지 이동을 문서 전체 로드 대신 `<body>` 교체로 처리한다(Next.js 사이트의 클라이언트 이동과 같다).
    Chrome처럼 View Transitions API가 있는 브라우저는 `<html transition:animate="none">`으로 애니메이션을 끄고,
    없는 브라우저는 `fallback="swap"`으로 바로 교체한다. */}
<ClientRouter fallback="swap" />

<script>
  import { swapFunctions } from "astro:transitions/client";
  import { swapShellBody } from "@/components/layout/shell-navigation";

  document.addEventListener("astro:before-swap", (event) => {
    const { newDocument } = event;

    // 기본 swap에서 `swapRootAttributes`를 뺀다. `<html>`에는 테마 상태(`class="dark"`, `style="color-scheme"`,
    // `data-seed-user-color-scheme`)와 `data-docs-hydrated`가 있는데, 기본 swap은 이를 새 페이지의 정적 값(라이트)으로
    // 되돌려 이동할 때마다 깜빡인다. 모든 페이지가 `Layout.astro`의 같은 정적 속성을 내보내므로 바꿀 속성이 없다.
    event.swap = () => {
      swapFunctions.deselectScripts(newDocument);
      swapFunctions.swapHeadElements(newDocument);
      // 문서 셸(`DocsShell`)을 유지할 수 있으면 셸은 두고 페이지 부분만 바꾼다. 아니면 body를 통째로 바꾼다.
      if (swapShellBody(newDocument)) return;
      const restoreFocus = swapFunctions.saveFocus();
      swapFunctions.swapBodyElement(newDocument.body, document.body);
      restoreFocus();
    };
  });
</script>
