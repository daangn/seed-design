---
import type { AST } from "@seed-design/rootage-core";
import { getComponentVariantTableItems } from "@/components/component-variant-items";
import { ComponentVariantTable } from "@/components/component-variant-table";
import { stringifyVariants } from "@/components/rootage";
import { getRootage } from "@/lib/rootage";

interface Props {
  id: string;
  headingComponent?: "h3" | "h4";
  variants?: string[];
}

const { id, headingComponent: Heading = "h3", variants } = Astro.props;
const rootage = await getRootage();
const componentSpec = rootage.componentSpecEntities[id];

if (!componentSpec) {
  throw new Error(`Component spec ${id} not found`);
}

function getVariantDescriptions(variantExpressions: AST.VariantExpression[]) {
  return variantExpressions.flatMap((variant) => {
    const schemaVariant = componentSpec.schema.variants.find((v) => v.name === variant.name);
    const schemaValue = schemaVariant?.values.find((v) => v.name === variant.value);

    return schemaValue?.description
      ? [{ name: `${variant.name}=${variant.value}`, description: schemaValue.description }]
      : [];
  });
}

const blocks = componentSpec.body.flatMap((variantDecl) => {
  const variantKey = stringifyVariants(variantDecl.variants);
  if (variants && !variants.includes(variantKey)) return [];

  return [
    {
      variantKey,
      descriptions: getVariantDescriptions(variantDecl.variants),
      items: getComponentVariantTableItems(rootage, variantDecl, componentSpec.schema),
    },
  ];
});
---

{
  blocks.map(({ variantKey, descriptions, items }) => (
    <>
      <Heading>{variantKey}</Heading>
      {descriptions.length > 0 && (
        <ul class="text-fd-muted-foreground text-sm mt-1 mb-4 list-disc list-inside">
          {descriptions.map((item) => (
            <li>
              {descriptions.length > 1 && (
                <>
                  <strong>{item.name}</strong>
                  {": "}
                </>
              )}
              {item.description}
            </li>
          ))}
        </ul>
      )}
      <ComponentVariantTable client:visible items={items} />
    </>
  ))
}
