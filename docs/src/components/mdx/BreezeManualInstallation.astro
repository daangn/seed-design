---
import { readRegistryItem } from "@/lib/registry-item";
import InstallationSteps from "./InstallationSteps.astro";

interface Props {
  name: string;
}

const { name } = Astro.props;
const item = await readRegistryItem(`react/breeze/${name}`).catch((error) => {
  console.error(`Failed to load breeze registry for ${name}:`, error);
  return null;
});
const snippets = (extension: string, lang: string) =>
  (item?.snippets ?? [])
    .filter((snippet) => snippet.path.endsWith(extension))
    .map(({ content }) => ({ content, lang }));
---

{
  item ? (
    <InstallationSteps
      dependencies={item.dependencies}
      steps={[
        { title: "컴포넌트 코드 복사", snippets: snippets(".tsx", "tsx") },
        { title: "스타일 복사", snippets: snippets(".module.css", "css") },
      ]}
    />
  ) : (
    <div>Breeze 레지스트리를 불러올 수 없습니다. `bun generate:all`을 실행해주세요.</div>
  )
}
