---
import { readRegistryItem } from "@/lib/registry-item";
import InstallationSteps from "./InstallationSteps.astro";

interface Props {
  name: string;
}

const { name } = Astro.props;
const item = await readRegistryItem(`lynx/ui/${name}`).catch((error) => {
  console.error(`Failed to load lynx registry for ${name}:`, error);
  return null;
});
---

{
  item ? (
    <InstallationSteps
      dependencies={item.dependencies}
      steps={[
        {
          title: "아래 코드를 복사 후 붙여넣고 사용하세요",
          snippets: item.snippets.map(({ content }) => ({ content, lang: "tsx" })),
        },
      ]}
    />
  ) : (
    <div>Lynx 레지스트리를 불러올 수 없습니다. `bun generate:all`을 실행해주세요.</div>
  )
}
