---
import { HighlightedPre } from "@/components/codeblock/highlighted-pre";
import { MdxIsland } from "@/components/mdx-island";
import { readRegistryItem } from "@/lib/registry-item";
import type { MdxIslandNode } from "@/lib/satteri/rehype-mdx-islands";

interface Props {
  name: string;
}

const block = await readRegistryItem(`react/block/${Astro.props.name}`);
const dependencies = await Promise.all(
  (block.innerDependencies ?? []).flatMap((dependency) =>
    dependency.itemIds.map((itemId) =>
      readRegistryItem(`react/${dependency.registryId}/${itemId}`),
    ),
  ),
);

const [mainSnippet] = block.snippets;
const files = [mainSnippet, ...dependencies.flatMap((dependency) => dependency.snippets)];

const tree: MdxIslandNode[] =
  files.length === 1
    ? [["CodeBlock", {}, { slot: "s0" }]]
    : [
        [
          "CodeTabs",
          {
            items: files.map((file, index) => ({
              value: file.path,
              label: file.path,
              children: { slot: `s${index}` },
            })),
          },
        ],
      ];
---

<MdxIsland client:visible tree={tree}>
  {
    files.map((file, index) => (
      <Fragment slot={`s${index}`}>
        <HighlightedPre code={file.content} lang="tsx" />
      </Fragment>
    ))
  }
</MdxIsland>
