{
  "version": "1.0",
  "description": "SEED Design System 스킬 자동 활성화 규칙",
  "skills": {
    "react-docs-generator": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "React 컴포넌트 구현 문서를 생성합니다",
      "promptTriggers": {
        "keywords": [
          "react documentation",
          "component docs",
          "implementation docs",
          "api documentation",
          "react 문서",
          "컴포넌트 문서",
          "구현 문서",
          "리액트 문서"
        ],
        "intentPatterns": [
          "(generate|create|write|update|작성|생성|업데이트).*(react|리액트).*(doc|documentation|문서)",
          "(document|문서화).*(react|리액트).*(component|컴포넌트)",
          "ComponentExample",
          "ManualInstallation"
        ]
      }
    },
    "react-headless-dev": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "React Headless 컴포넌트를 개발합니다",
      "promptTriggers": {
        "keywords": [
          "headless component",
          "unstyled component",
          "custom hook",
          "primitive composition",
          "react-headless",
          "헤드리스 컴포넌트",
          "커스텀 훅",
          "프리미티브"
        ],
        "intentPatterns": [
          "(create|implement|develop|개발|구현).*(headless|unstyled|헤드리스).*(component|hook|컴포넌트|훅)",
          "use[A-Z][a-zA-Z]+",
          "(data-attributes|data attributes|데이터 속성)",
          "(namespace pattern|네임스페이스)"
        ]
      }
    },
    "component-guidelines-docs": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "컴포넌트 디자인 가이드라인 문서를 작성합니다",
      "promptTriggers": {
        "keywords": [
          "component guidelines",
          "design documentation",
          "anatomy",
          "props table",
          "가이드라인",
          "디자인 문서",
          "컴포넌트 가이드라인",
          "props 테이블"
        ],
        "intentPatterns": [
          "(generate|create|write|update|작성|생성|업데이트).*(guideline|design|가이드라인|디자인).*(doc|documentation|문서)",
          "(document|문서화).*(component|컴포넌트).*(guideline|가이드라인)",
          "rootage yaml",
          "ComponentSpecBlock",
          "PlatformStatusTable"
        ]
      }
    },
    "docs-consistency-checker": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "문서 레이어 간 일관성을 검증합니다",
      "promptTriggers": {
        "keywords": [
          "docs consistency",
          "documentation audit",
          "validate docs",
          "check documentation",
          "pre-release validation",
          "문서 검증",
          "일관성 체크",
          "문서 일관성",
          "릴리스 전 검증"
        ],
        "intentPatterns": [
          "(validate|check|audit|verify|검증|확인|검사).*(doc|documentation|문서).*(consistency|completeness|일관성|완전성)",
          "(pre-?release|릴리스 전).*(validation|check|검증|확인)",
          "(find|detect|찾기|감지).*(missing|inconsistent|누락|불일치).*(docs|documentation|문서)"
        ]
      }
    }
  }
}
